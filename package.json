{
  "name": "magic-garden-loader",
  "productName": "SSK's Garden Buddy",
  "version": "0.22.2",
  "description": "SSK's Garden Buddy: a friendly helper for Magic Garden. Shop alerts, weather teams, pet and garden trackers, Bad Luck Protection counters, and more.",
  "author": "Spread Sheet King",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "32.3.3",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "gg.local.magicgardenloader",
    "productName": "SSK's Garden Buddy",
    "files": [
      "main.js",
      "alerts.js",
      "store.js",
      "voices.js",
      "pet-data.js",
      "ability-data.js",
      "crop-data.js",
      "russian.js",
      "tts.js",
      "preload-game.js",
      "garden-observer.js",
      "preload-control.js",
      "control.html",
      "parked.html",
      "weather.js",
      "rooms.js",
      "pity.js",
      "game-data.js",
      "backup.js",
      "fun.js",
      "luck.js",
      "updater.js",
      "default-scripts/**/*"
    ],
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "artifactName": "SSKs-Garden-Buddy-Windows.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "SSKs-Garden-Buddy-Windows.${ext}"
    },
    "mac": {
      "target": [
        "dir"
      ],
      "category": "public.app-category.games",
      "identity": null,
      "artifactName": "SSKs-Garden-Buddy-Mac.${ext}"
    }
  },
  "license": "MIT",
  "homepage": "https://shea4it.github.io/ssks-garden-buddy/",
  "repository": {
    "type": "git",
    "url": "https://github.com/shea4it/ssks-garden-buddy.git"
  }
}
